/// Modules for describing [Arazzo](https://www.openapis.org/arazzo-specification) v1.0 workflow documents
amends "pkl:Project"

package {
  name = "arazzo"
  baseUri = "package://github.com/makecph/pkl-arazzo/\(name)"
  version = "1.0.0-alpha.1"
  packageZipUrl = "https://github.com/makecph/pkl-arazzo/releases/download/v\(version)/\(name)@\(version).zip"
  license = "Apache-2.0"
  authors { "oss@makecph.com" }
  description = "Pkl modules for describing Arazzo workflow documents"
  exclude {
    "examples/**"
    "tests/**"
    "scripts/**"
    "schemas/**"
  }
  issueTracker = "https://github.com/makecph/pkl-arazzo/issues"
  sourceCode = "https://github.com/makecph/pkl-arazzo"
  sourceCodeUrlScheme = "https://github.com/makecph/pkl-arazzo/blob/v\(version)%{path}#L%{line}-%{endLine}"
}
