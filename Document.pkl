/// The root of an [Arazzo](https://www.openapis.org/arazzo-specification) description.
///
/// This module follows version 1.1.x of the Arazzo Specification.
///
/// <https://spec.openapis.org/arazzo/v1.1.0#arazzo-description>
open module arazzo.Document

import "Components.pkl"
import "Extension.pkl"
import "Info.pkl"
import "SourceDescription.pkl"
import "Workflow.pkl"
import "ExpressionType.pkl" as _ExpressionType
import "FailureAction.pkl" as _FailureAction
import "Parameter.pkl" as _Parameter
import "Reusable.pkl" as _Reusable
import "Selector.pkl" as _Selector
import "SuccessAction.pkl" as _SuccessAction

/// This string MUST be the version number of the Arazzo Specification that the Arazzo description uses.
///
/// The `arazzo` field SHOULD be used by tooling to interpret the Arazzo description. This package tracks the
/// Arazzo minor version: package versions `1.1.x` implement Arazzo 1.1 (the 1.1.0 patch release). Use a `1.0.x`
/// package version for Arazzo 1.0.
arazzo: "1.1.0" = "1.1.0"

/// A URI-reference that identifies this document, used as the base for resolving relative references.
///
/// MUST NOT contain a fragment.
`$self`: Uri(!contains("#"))?

/// Provides metadata about the Arazzo description.
info: Info

/// A list of source descriptions (such as OpenAPI descriptions or other Arazzo descriptions) that the
/// workflows reference.
sourceDescriptions: Listing<SourceDescription>(!isEmpty, isDistinct)

/// A list of workflows.
///
/// Each `workflowId` MUST be unique within the document.
workflows: Listing<Workflow>(!isEmpty, isDistinct)

/// An element to hold various reusable objects for the Arazzo description.
components: Components?

// re-export types so they are available without import
typealias ExpressionType = _ExpressionType
typealias FailureAction = _FailureAction
typealias Parameter = _Parameter
typealias Reusable = _Reusable
typealias Selector = _Selector
typealias SuccessAction = _SuccessAction

output {
  // noinspection TypeMismatch
  local const format: "json" | "yaml" = read?("prop:pkl.outputFormat") ?? "json"

  local const renderers: Mapping<String, ValueRenderer> = new {
    ["json"] = new JsonRenderer {}
    ["yaml"] = new YamlRenderer {}
  }

  renderer = (renderers[format]) {
    converters = Extension.converters
  }
}
