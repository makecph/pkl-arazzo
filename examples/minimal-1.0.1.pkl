amends "../Document.pkl"

arazzo = "1.0.1"

info {
  title = "Minimal Arazzo document"
  version = "1.0.0"
}

sourceDescriptions {
  new {
    name = "api"
    url = "./openapi.yaml"
  }
}

workflows {
  new {
    workflowId = "ping"
    steps {
      new {
        stepId = "ping"
        operationId = "ping"
        successCriteria {
          new { condition = "$statusCode == 200" }
        }
      }
    }
  }
}
