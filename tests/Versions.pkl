/// Tests for the Arazzo spec version this package line supports, 1.1.0.
///
/// Arazzo 1.0.x documents are produced by the `1.0.x` package line, and 1.1 is not backwards compatible at the
/// schema level (for example, the `flat` criterion `version` of 1.0 does not exist in 1.1), so they are rejected.
module arazzo.tests.Versions

amends "pkl:test"

import "pkl:json"
import "../examples/login-and-retrieve-pets.pkl" as withoutExplicitVersion
import "../examples/minimal-1.1.0.pkl" as minimal

local parser = new json.Parser {}

local function parse(doc: Module): Dynamic = parser.parse(doc.output.text)

local function rejected(doc: Module): Boolean = module.catchOrNull(() -> doc.output.text) != null

facts {
  ["the document declares arazzo 1.1.0"] {
    parse(minimal).arazzo == "1.1.0"
  }

  ["arazzo defaults to 1.1.0 when unset"] {
    parse(withoutExplicitVersion).arazzo == "1.1.0"
  }

  ["other versions are rejected"] {
    for (unsupported in List("1.0.0", "1.0.1", "1.0", "1.1", "1.1.1", "1.2.0", "2.0.0", "")) {
      rejected((minimal) { arazzo = unsupported })
    }
  }
}
